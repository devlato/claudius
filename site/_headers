# Response headers, which Cloudflare adds to the site's files (site/wrangler.toml).
# Rules apply in file order and a request gets the headers of every rule it matches; a header set twice is joined
# with a comma, which for Content-Security-Policy would enforce both policies. The /docs/* and /studio/* rules
# therefore detach the site-wide policy ("! Content-Security-Policy") before setting their own.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; media-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'none'; frame-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests; require-trusted-types-for 'script'; trusted-types 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), hid=(), magnetometer=(), microphone=(), midi=(), payment=(), serial=(), usb=(), xr-spatial-tracking=(), browsing-topics=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin

# mdBook writes inline scripts into every page (the theme switch, the sidebar, the path to its content-hashed search
# index), so their hashes change whenever the docs do. Its chrome.css uses one data: SVG.
/docs/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; media-src 'self'; connect-src 'self'; worker-src 'none'; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests

# The web studio (trunk + wasm-bindgen + egui): 'wasm-unsafe-eval' compiles the WebAssembly (it allows no JavaScript
# eval); trunk's index.html starts the app from an inline module script that names the hashed files of each build,
# and carries an inline <style>; the demo plays its rendered previews from blob: URLs, and runs the engine in a Web
# Worker of the site's own (claudius-engine_loader.js), which gets this policy too. It records takes off the
# microphone and plays MIDI keyboards, so it may ask for both; the browser still asks the person first.
/studio/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; media-src 'self' blob:; connect-src 'self'; worker-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  ! Permissions-Policy
  Permissions-Policy: accelerometer=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), hid=(), magnetometer=(), microphone=(self), midi=(self), payment=(), serial=(), usb=(), xr-spatial-tracking=(), browsing-topics=()

# The radio: the site's policy, but it starts the studio demo's engine as its Web Worker (claudius-engine_loader.js
# under /studio/, whose own policy compiles the WebAssembly), its URL made by the page's one Trusted Types policy
/radio/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; media-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests; require-trusted-types-for 'script'; trusted-types claudius-radio

# The page a phone plays along with the demo on: a MIDI controller plugged into what opens it (a drum pad, a jog wheel)
# plays its pads, keys and turntable, and its turntable plays a record recorded off the microphone, so it may ask for
# MIDI and the microphone, and nothing else
/phone/*
  ! Permissions-Policy
  Permissions-Policy: accelerometer=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), hid=(), magnetometer=(), microphone=(self), midi=(self), payment=(), serial=(), usb=(), xr-spatial-tracking=(), browsing-topics=()

# caching: trunk and mdBook (0.5 and later) put a content hash in these file names
/studio/*.wasm
  Cache-Control: public, max-age=31536000, immutable
/studio/*.js
  Cache-Control: public, max-age=31536000, immutable
# the demo's engine, a Web Worker, which trunk names without a hash: each visit checks for a newer one
/studio/claudius-engine*
  ! Cache-Control
  Cache-Control: no-cache
# the instruments the demo plays (`cargo xtask site --sounds`), which change only when a pack's source does
/studio/packs/*
  ! Cache-Control
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
# the palette's embedding model (`cargo xtask site --sounds`), from a pinned revision: it changes only with claudius
/studio/models/*
  ! Cache-Control
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/docs/*.js
  Cache-Control: public, max-age=31536000, immutable
/docs/*.css
  Cache-Control: public, max-age=31536000, immutable
/docs/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# the landing page's own files: rename a font, image or song to change it; CSS and JS carry ?v={{version}}
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/assets/img/*
  Cache-Control: public, max-age=2592000
/assets/*.css
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/assets/*.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/assets/*.svg
  Cache-Control: public, max-age=604800
/audio/*
  Cache-Control: public, max-age=2592000
/audio/*.rhai
  Content-Type: text/plain; charset=utf-8
/og.png
  Cache-Control: public, max-age=604800
/favicon.svg
  Cache-Control: public, max-age=604800
/favicon-32.png
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
/icon-512.png
  Cache-Control: public, max-age=604800

# installers: always the current one, readable in a browser before you pipe it to a shell
/install.sh
  Cache-Control: no-cache
  Content-Type: text/plain; charset=utf-8
/install.ps1
  Cache-Control: no-cache
  Content-Type: text/plain; charset=utf-8
