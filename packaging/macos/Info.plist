<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Claudius.app's Info.plist; scripts/package/macos.sh fills in {{version}} -->
<plist version="1.0">
<dict>
  <!-- a Claudius project (.claudius) opens in Claudius: double-clicked in the Finder, dropped on the Dock's icon, or
       with Open With. The app takes the files as an Apple Event (crates/claudius-macos). A project is a zip by a name of
       its own, and its type conforms to public.data rather than public.zip-archive, so that Safari and Archive Utility
       keep it whole rather than unpacking it into a folder. -->
  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key>
      <string>Claudius project</string>
      <key>CFBundleTypeRole</key>
      <string>Editor</string>
      <key>LSHandlerRank</key>
      <string>Owner</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>io.github.devlato.claudius.project</string>
      </array>
    </dict>
  </array>
  <key>UTExportedTypeDeclarations</key>
  <array>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>io.github.devlato.claudius.project</string>
      <key>UTTypeDescription</key>
      <string>Claudius project</string>
      <key>UTTypeConformsTo</key>
      <array>
        <string>public.data</string>
        <string>public.content</string>
      </array>
      <key>UTTypeIconFile</key>
      <string>claudius</string>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array>
          <string>claudius</string>
        </array>
        <key>public.mime-type</key>
        <array>
          <string>application/x-claudius-project</string>
        </array>
      </dict>
    </dict>
  </array>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleDisplayName</key>
  <string>Claudius</string>
  <key>CFBundleExecutable</key>
  <string>Claudius</string>
  <key>CFBundleIconFile</key>
  <string>claudius</string>
  <key>CFBundleIdentifier</key>
  <string>io.github.devlato.claudius</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundleName</key>
  <string>Claudius</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleShortVersionString</key>
  <string>{{version}}</string>
  <key>CFBundleVersion</key>
  <string>{{version}}</string>
  <key>LSApplicationCategoryType</key>
  <string>public.app-category.music</string>
  <key>LSMinimumSystemVersion</key>
  <string>11.0</string>
  <key>NSHighResolutionCapable</key>
  <true/>
  <key>NSHumanReadableCopyright</key>
  <string>MIT licence. The sample packs and listening models it downloads have their own.</string>
  <key>NSMicrophoneUsageDescription</key>
  <string>Claudius listens to your microphone or audio interface while its Record window is open, to show the input's level and record takes, and at no other time.</string>
  <key>NSDownloadsFolderUsageDescription</key>
  <string>Claudius opens the recordings and songs that you or your assistant name in your Downloads folder, to add, sample or open them, and saves there only what you choose to.</string>
  <key>NSDesktopFolderUsageDescription</key>
  <string>Claudius opens the recordings and songs that you or your assistant name on your Desktop, to add, sample or open them, and saves there only what you choose to.</string>
  <key>NSDocumentsFolderUsageDescription</key>
  <string>Claudius opens the recordings and songs that you or your assistant name in your Documents folder, to add, sample or open them, and saves there only what you choose to.</string>
  <key>NSRemovableVolumesUsageDescription</key>
  <string>Claudius opens the recordings, songs and sample packs that you or your assistant name on a drive you plug in, and saves there only what you choose to.</string>
  <key>NSNetworkVolumesUsageDescription</key>
  <string>Claudius opens the recordings, songs and sample packs that you or your assistant name on a network drive, and saves there only what you choose to.</string>
</dict>
</plist>
