{
  "permissions": {
    "allow": [
      "Bash(cargo xtask *)",
      "Bash(cargo build *)",
      "Bash(cargo check *)",
      "Bash(cargo clippy *)",
      "Bash(cargo fmt *)",
      "Bash(cargo test *)",
      "Bash(cargo nextest *)",
      "Bash(cargo run *)",
      "Bash(cargo insta *)",
      "Bash(cargo deny *)",
      "Bash(.claude/hooks/ci.sh)",
      "Bash(.claude/hooks/ci.sh *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git fetch *)",
      "Bash(git switch *)",
      "Bash(git worktree *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git rebase *)",
      "Bash(git push *)",
      "Bash(gh pr *)",
      "Bash(gh run *)",
      "Bash(gh release view *)",
      "Bash(gh release list *)",
      "Bash(typos)",
      "Bash(typos *)",
      "Bash(lychee *)",
      "Bash(shellcheck *)",
      "Bash(actionlint)",
      "Bash(actionlint *)",
      "Bash(mdbook *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.sh\"; [ -x \"$f\" ] || exit 0; exec \"$f\"",
            "timeout": 3600,
            "onFailure": "block",
            "statusMessage": "Holding to AGENTS.md (a push waits for cargo xtask ci)"
          }
        ]
      }
    ]
  }
}
