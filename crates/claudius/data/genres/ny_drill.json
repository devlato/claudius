    {"name": "choir", "role": "pad", "presets": ["choir|vowel_pad", "string_ensemble|strings", "choir|warm_pad"], "styles": ["sustain"], "register": [48, 72], "voices": 3, "voicing": "open", "optional": 0.2, "mix": {"level_db": -2, "reverb": 0.45, "fx": [{"fx": "width", "width": 1.5, "mono_below_hz": 200}]}}
