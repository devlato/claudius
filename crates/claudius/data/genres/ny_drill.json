  },
  "transitions": {"riser": false, "impact": true, "downlifter": false, "reverse_crash": true, "riser_bars": 2, "mix": {"bus": "fx", "reverb": 0.2, "level_db": -2}},
  "mix": {
    "lufs": -8.5,
    "reverb": {"fx": "reverb", "decay": 2.2, "damping": 0.5, "predelay_ms": 15, "width": 1.3, "mix": 1.0, "lowcut": 300},
    "delay": {"fx": "delay", "beats": 0.75, "feedback": 0.3, "damping": 0.5, "pingpong": true, "mix": 1.0},
    "buses": {
