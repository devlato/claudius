  "swing": [0.5, 0.53],
  "humanize": 0.06,
  "modes": [["minor", 0.6], ["phrygian", 0.25], ["harmonic_minor", 0.15]],
  "harmony": [["minimal", 0.5], ["minor_dark", 0.3], ["phrygian", 0.2]],
