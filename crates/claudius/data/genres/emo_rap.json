      "listen": "a clean guitar picking a melancholy loop",
      "treat": {"as it is": 0.6, "darkened": 0.25, "filtered until it lifts": 0.15},
      "seconds": [4, 900],
      "keep": 8,
      "chance": 0.95,
      "chop": 0.3,
