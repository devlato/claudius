    {"name": "lead", "role": "lead", "presets": ["pluck", "soft_lead", "piano|keys"], "styles": ["motif"], "register": [64, 84], "density": [0.2, 0.35], "optional": 0.4, "mix": {"level_db": -5, "reverb": 0.35, "delay": 0.25}}
