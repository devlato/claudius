{
  "name": "boom_bap",
  "family": "hip hop",
  "aliases": ["90s hip hop", "east coast", "golden age", "new york hip hop", "underground hip hop", "dj premier", "pete rock"],
  "description": "Boom bap: 90s hip hop at 86 to 96 BPM, built on samples: a dusty drum break with a lazy sampler swing, a soul or jazz phrase from a record chopped and crushed to 12 bits, vinyl crackle, a rim, an upright or sub bass, horn or flute phrases in the hooks, three verses and hooks",
  "query": "boom bap hip hop beat",
  "alts": ["lo-fi hip hop beat", "trap beat", "jazz music", "funk music"],
  "accepted_flaws": ["a low quality recording with hiss"],
  "bpm": [86, 96],
  "swing": [0.55, 0.62],
  "humanize": 0.45,
  "modes": [["minor", 0.5], ["dorian", 0.35], ["phrygian", 0.15]],
  "harmony": [["minor_soul", 0.4], ["dorian_vamp", 0.25], ["minor_dark", 0.2], ["minimal", 0.15]],
  "markov": 0.15,
  "ext": 1,
  "bars_per_chord": [[1, 0.4], [2, 0.6]],
  "forms": [
