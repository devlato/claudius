      {"name": "verse", "kind": "verse", "bars": 16, "energy": 0.65, "layers": ["break", "rim", "bass", "sample", "texture"], "fills": true},
      {"name": "hook", "kind": "hook", "bars": 8, "energy": 0.85, "layers": ["break", "ohat", "rim", "bass", "sample", "horns", "texture"], "fills": true},
      {"name": "verse2", "kind": "verse", "bars": 16, "energy": 0.7, "layers": ["break", "rim", "bass", "sample", "texture", "pad"], "fills": true},
      {"name": "hook2", "kind": "hook", "bars": 8, "energy": 0.9, "layers": ["break", "ohat", "rim", "bass", "sample", "horns", "texture", "pad"], "fills": true},
      {"name": "verse3", "kind": "verse", "bars": 16, "energy": 0.7, "layers": ["break", "rim", "bass", "sample", "texture"], "fills": true},
      {"name": "hook3", "kind": "hook", "bars": 8, "energy": 0.95, "layers": ["break", "ohat", "rim", "bass", "sample", "horns", "texture", "pad"], "fills": true},
      {"name": "outro", "kind": "outro", "bars": 8, "energy": 0.35, "layers": ["sample", "pad", "texture"]}
    ]
  ],
