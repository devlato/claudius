  "sampling": {
    "by_default": true,
    "phrase": {
      "search": ["70s soul", "soul vocal", "sweet soul", "soul ballad", "motown", "gospel", "philly soul", "doo wop", "soul choir", "soul strings"],
      "listen": "a soul record with a voice singing over it",
      "treat": {"as it is": 0.6, "filtered until it lifts": 0.3, "a telephone's band in the intro and the breaks": 0.1},
