    {"name": "shaker", "voice": "shaker", "template": {"steps": [0.6, 0.4, 0.7, 0.4, 0.6, 0.4, 0.7, 0.4, 0.6, 0.4, 0.7, 0.4, 0.6, 0.4, 0.7, 0.4], "vel": [0.15, 0.35]}, "mix": {"bus": "drums", "pan": -0.3}, "late_ms": [-6, -1]}
