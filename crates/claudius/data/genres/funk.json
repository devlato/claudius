    {"name": "guitar", "role": "chords", "presets": ["freepats:clean_guitar|pluck", "freepats:jazz_guitar|pluck", "clav"], "styles": ["stabs", "syncopated", "offbeat"], "register": [52, 76], "voices": 3, "voicing": "close", "mix": {"pan": 0.3, "reverb": 0.12, "fx": [{"fx": "filter", "mode": "hp", "cutoff": 250, "res": 0.05}, {"fx": "compressor", "threshold_db": -20, "ratio": 4, "attack_ms": 3, "release_ms": 60, "knee_db": 4, "makeup_db": 2}, {"fx": "phaser", "rate_hz": 0.6, "stages": 4, "depth": 0.6, "feedback": 0.3, "mix": 0.25}]}},
