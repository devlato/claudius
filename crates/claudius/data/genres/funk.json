      {"name": "verse2", "kind": "verse", "bars": 16, "energy": 0.7, "layers": ["kick", "snare", "hat", "perc", "bass", "guitar", "keys"], "fills": true},
      {"name": "hook2", "kind": "hook", "bars": 16, "energy": 0.9, "layers": ["kick", "snare", "hat", "ohat", "perc", "shaker", "bass", "guitar", "keys", "horns"], "fills": true},
      {"name": "outro", "kind": "outro", "bars": 8, "energy": 0.45, "layers": ["kick", "snare", "hat", "bass", "guitar"]}
    ]
  ],
