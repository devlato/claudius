  "sampling": {
    "by_default": false,
    "break": {
      "search": ["soul drum break", "breakbeat", "live drums", "70s drums", "drum solo", "drum break"],
      "listen": "a tight drum break from a 70s record",
      "seconds": [2, 40],
      "keep": 4,
      "chance": 0.35,
      "chop": 0.3,
      "instead": ["kick", "snare", "hat"],
      "mix": {"bus": "drums", "fx": [{"fx": "saturate", "kind": "tape", "drive_db": 2, "mix": 0.4}]}
    },
    "phrase": {
      "search": ["70s soul", "clavinet", "horn section", "rhythm guitar", "slap bass", "boogie", "organ groove", "wah guitar", "brass stabs", "soul strings"],
      "listen": "a tight guitar and horn phrase from a 70s record",
      "treat": {"as it is": 0.6, "filtered until it lifts": 0.25, "overloaded": 0.15},
      "seconds": [6, 900],
      "keep": 6,
      "chance": 0.9,
      "chop": 0.35,
      "pitch": [-3, 3],
      "instead": ["guitar"],
      "mix": {"bus": "music", "level_db": 1, "reverb": 0.1, "fx": [{"fx": "filter", "mode": "hp", "cutoff": 100, "res": 0.05}]}
    },
    "vocal": {
      "search": ["soul vocal", "a cappella", "vocal shout", "gospel vocal"],
      "listen": "a soul singer holding a note",
      "seconds": [1, 400],
      "keep": 4,
      "chance": 0.3
    },
    "bass": {
      "search": ["slap bass", "bass guitar single note", "electric bass note"],
      "listen": "a punchy electric bass note",
      "seconds": [0.3, 30],
      "keep": 3,
      "chance": 0.5
    }
  },
  "transitions": {"riser": false, "impact": false, "downlifter": false, "reverse_crash": false, "riser_bars": 2, "mix": {"bus": "fx", "reverb": 0.2}},
  "mix": {
    "lufs": -10.0,
    "reverb": {"fx": "reverb", "decay": 0.9, "damping": 0.55, "predelay_ms": 8, "width": 1.1, "mix": 1.0, "lowcut": 300},
    "delay": {"fx": "delay", "beats": 0.5, "feedback": 0.2, "damping": 0.6, "pingpong": false, "mix": 1.0},
