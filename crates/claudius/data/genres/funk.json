    {"name": "horns", "role": "lead", "presets": ["brass|brass_lead", "trumpet|brass_lead", "sax|brass_lead"], "styles": ["motif"], "register": [60, 82], "density": [0.3, 0.5], "optional": 0.25, "mix": {"reverb": 0.2, "delay": 0.1}}
