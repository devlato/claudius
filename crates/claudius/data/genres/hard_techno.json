      {"name": "break", "kind": "break", "bars": 8, "energy": 0.4, "layers": ["chords", "lead", "ride"]},
      {"name": "build", "kind": "build", "bars": 8, "energy": 0.7, "layers": ["clap", "hat", "ride", "chords", "lead"], "build": true, "gap": true},
      {"name": "peak", "kind": "drop", "bars": 32, "energy": 1.0, "layers": ["kick", "hat", "ohat", "clap", "perc", "ride", "bass", "lead", "chords"], "impact": true, "fills": true},
      {"name": "break2", "kind": "break", "bars": 8, "energy": 0.4, "prog": "B", "layers": ["pad", "lead", "ride"]},
      {"name": "build2", "kind": "build", "bars": 8, "energy": 0.7, "prog": "B", "layers": ["clap", "hat", "ride", "pad", "lead"], "build": true, "gap": true},
      {"name": "peak2", "kind": "drop", "bars": 32, "energy": 1.0, "layers": ["kick", "hat", "ohat", "clap", "perc", "ride", "bass", "lead", "chords"], "impact": true, "fills": true},
      {"name": "outro", "kind": "outro", "bars": 16, "energy": 0.5, "layers": ["kick", "hat", "perc"], "variant": "sparse"}
