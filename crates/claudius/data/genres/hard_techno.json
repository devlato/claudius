      "variants": {"sparse": {"steps": [0, 0, 1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 0, 1, 0], "vel": [0.6, 0.85]}},
      "params": {"decay": [0.03, 0.07], "tone": [0.6, 0.9]},
      "samples": ["Hi-hat"],
      "choke": "hats",
      "mix": {"bus": "drums", "pan": 0.1}
    },
    {
