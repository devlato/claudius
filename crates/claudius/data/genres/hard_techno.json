{
  "name": "hard_techno",
  "family": "hard dance",
  "aliases": ["schranz", "industrial hard techno"],
  "description": "Hard techno: 145 to 155 BPM, a heavily distorted kick pounding every beat with a rumbling bass rolling under it, relentless offbeat hats and rides, metallic percussion and industrial stabs, an acid or saw lead, short breaks that slam back in",
  "query": "hard techno music with a distorted pounding kick",
  "alts": ["techno music", "drum and bass music", "trance music", "dubstep music"],
