  "sampling": {
    "by_default": false,
    "phrase": {
      "search": ["roots", "dub", "ska", "rocksteady", "lovers rock", "jamaican organ", "horn section", "skank guitar"],
      "listen": "a laid-back Jamaican phrase with organ and guitar",
      "treat": {"as it is": 0.7, "darkened": 0.3},
      "seconds": [6, 900],
      "keep": 6,
      "chance": 0.4,
      "chop": 0.3,
