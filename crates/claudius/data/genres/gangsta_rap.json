      "seconds": [5, 600],
      "keep": 3,
      "chance": 0.7,
      "mix": {"bus": "music"}
    }
  },
  "transitions": {"riser": false, "impact": false, "downlifter": false, "reverse_crash": true, "riser_bars": 2, "mix": {"bus": "fx", "reverb": 0.25}},
