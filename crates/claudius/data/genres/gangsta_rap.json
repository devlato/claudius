  "sampling": {
    "by_default": true,
    "break": {
      "search": ["funk drum break", "soul drum break", "breakbeat", "hip hop drum loop", "dusty drum loop", "70s drums", "live drums"],
      "listen": "a hard, dusty hip hop drum break",
      "seconds": [2, 40],
      "keep": 6,
      "chance": 0.95,
      "chop": 0.3,
      "instead": ["kick", "snare", "hat"],
      "mix": {"bus": "drums", "fx": [{"fx": "saturate", "kind": "tape", "drive_db": 4, "mix": 0.5}, {"fx": "filter", "mode": "lp", "cutoff": 12000, "res": 0.05}]}
    },
    "phrase": {
      "search": ["film score", "horror film", "suspense", "minor piano", "cello", "orchestral strings", "string quartet", "old film", "piano"],
      "listen": "a menacing minor piano or string phrase from an old film score",
      "treat": {"as it is": 0.5, "filtered until it lifts": 0.2, "overloaded": 0.2, "a telephone's band in the intro and the breaks": 0.1},
