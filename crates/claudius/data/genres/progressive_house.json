{
  "name": "progressive_house",
  "family": "edm",
  "aliases": ["progressive", "prog house", "swedish house"],
  "description": "Progressive house: 124 to 128 BPM, euphoric and melodic: four on the floor with a clap and offbeat hats, piano chords and plucks over warm minor and major progressions, a big supersaw hook, long builds and breakdowns that bloom into anthemic drops",
  "query": "progressive house music with euphoric piano chords and big synths",
  "alts": ["trance music", "house music", "electro house music", "upbeat corporate pop music"],
  "bpm": [124, 128],
  "swing": [0.5, 0.52],
  "humanize": 0.06,
  "modes": [["minor", 0.55], ["major", 0.35], ["dorian", 0.1]],
  "harmony": [["minor_epic", 0.45], ["major_pop", 0.35], ["minor_80s", 0.2]],
  "markov": 0.1,
  "ext": 1,
  "bars_per_chord": [[1, 0.4], [2, 0.6]],
  "forms": [
