      "template": {"steps": [1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 0], "vel": [0.95, 1.0]},
      "params": {"decay": [0.35, 0.5], "tune": [45, 53], "tone": [0.35, 0.6], "punch": [0.45, 0.75], "drive": [4, 8]},
