      {"name": "break", "kind": "break", "bars": 16, "energy": 0.35, "prog": "B", "layers": ["piano", "pad", "lead"]},
      {"name": "build", "kind": "build", "bars": 8, "energy": 0.65, "prog": "B", "layers": ["clap", "hat", "piano", "pad", "lead", "arp"], "build": true, "gap": true},
      {"name": "drop", "kind": "drop", "bars": 16, "energy": 1.0, "layers": ["kick", "clap", "hat", "ohat", "shaker", "bass", "chords", "lead", "arp", "pad"], "impact": true, "fills": true},
      {"name": "break2", "kind": "break", "bars": 16, "energy": 0.4, "layers": ["piano", "pad", "arp"]},
      {"name": "build2", "kind": "build", "bars": 8, "energy": 0.7, "layers": ["clap", "hat", "piano", "pad", "lead", "arp"], "build": true, "gap": true},
      {"name": "drop2", "kind": "drop", "bars": 16, "energy": 1.0, "layers": ["kick", "clap", "hat", "ohat", "shaker", "bass", "chords", "lead", "arp", "pad", "piano"], "impact": true, "fills": true},
      {"name": "outro", "kind": "outro", "bars": 16, "energy": 0.4, "layers": ["kick", "hat", "shaker", "bass"], "variant": "sparse"}
    ]
  ],
  "drums": [
